---
// Blog (Figma: Page · Blog). Posts live in src/pages/posts and src/pages/blog.
import SiteLayout from "../layouts/SiteLayout.astro";
import Title from "../components/Title.astro";

const posts = Object.values({
  ...import.meta.glob("./posts/*.md", { eager: true }),
  ...import.meta.glob("./blog/*.md", { eager: true }),
}).sort((a, b) => (a.frontmatter.order ?? 9) - (b.frontmatter.order ?? 9));
const [featured, ...rest] = posts;
const pad = (n) => String(n).padStart(2, "0");
---

<SiteLayout title="Blog" section="writing" description="Notes from class, books, trips and the things I keep thinking about.">
  <div class="row row-2-1">
    <section class="tile t-navy pad-lg">
      <p class="label">Off the clock · Blog</p>
      <Title text="I write." />
      <p class="lede">Notes from class, books, trips and the things I keep thinking about.</p>
    </section>
    <section class="tile t-steel">
      <p class="label">Posts</p>
      <p class="num" style="font-size: 64px;">{pad(posts.length)}</p>
      <p class="muted">Newest first</p>
    </section>
  </div>

  <article class="row row-1-1 tile t-white flush" style="display: grid;">
    <figure class="media" style="border: 0; min-height: 320px;">
      {featured.frontmatter.image?.url && <img src={featured.frontmatter.image.url} alt="" style={`object-position: ${featured.frontmatter.focus ?? "center"}`} />}
      {featured.frontmatter.caption && <figcaption class="caption-strip">{featured.frontmatter.caption}</figcaption>}
    </figure>
    <div class="tile" style="border: 0;">
      <div class="top"><p class="label muted">Featured · {featured.frontmatter.category}</p><span class="tag tag-lime">New</span></div>
      <h2 class="display d-md">{featured.frontmatter.title}</h2>
      <p style="font-size: 18px;">{featured.frontmatter.description}</p>
      <a class="btn push" href={featured.url}>Read more →</a>
    </div>
  </article>

  <div class="row row-3">
    {rest.map((p) => (
      <article class="tile t-white flush">
        <figure class="media" style="aspect-ratio: 448 / 240; min-height: 0;">
          {p.frontmatter.image?.url && <img src={p.frontmatter.image.url} alt="" loading="lazy" style={`object-position: ${p.frontmatter.focus ?? "center"}`} />}
          {p.frontmatter.caption && <figcaption class="caption-strip">{p.frontmatter.caption}</figcaption>}
        </figure>
        <div class="tile" style="border: 0; flex: 1; gap: 10px;">
          <p class="label muted">{p.frontmatter.category}</p>
          <h3 class="display d-xs" style="font-size: 28px;">{p.frontmatter.title}</h3>
          <p class="small">{p.frontmatter.description}</p>
          <a class="link push" href={p.url}>Read more →</a>
        </div>
      </article>
    ))}
  </div>
</SiteLayout>
