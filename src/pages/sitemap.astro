---
// Sitemap (Figma: Page · Sitemap).
import SiteLayout from "../layouts/SiteLayout.astro";
import Title from "../components/Title.astro";
import { CV_URL } from "../data/site.js";

const groups = [
  ["Work", "t-white", [["Selected work", "/work"], ["Ponk Nagari of Surat", "/projects/project-1"], ["Janatotsav, Seondha", "/projects/project-2"]]],
  ["Notes", "t-steel", [["Design Notes", "/design"], ["Design Styles", "/design/styles"], ["Source Catalogue", "/design-source-catalogue"]]],
  ["Off the clock", "t-navy", [["Blog", "/blog"], ["Poetry", "/poetry"], ["Quotes", "/quotes"], ["Bookhouse", "/bookhouse"], ["Magazine", "/magazine"]]],
  ["About", "t-ice", [["Home", "/"], ["About me", "/about"], ["Socials", "/socials"], ["Download CV", CV_URL]]],
];
---

<SiteLayout title="Sitemap" description="Every page on the site, grouped the way the navigation is.">
  <section class="tile t-navy pad-lg">
    <p class="label">Sitemap</p>
    <Title text="Keep track." />
    <p class="lede">Every page on the site, grouped the way the navigation is.</p>
  </section>
  <div class="row row-4">
    {groups.map(([name, tone, links]) => {
      const dark = tone === "t-navy" || tone === "t-steel";
      return (
        <nav class={`tile ${tone}`} aria-label={name}>
          <div class="top"><h2 class="display d-xs" style="font-size: 28px;">{name}</h2><span class={`num ${dark ? "lime" : ""}`} style="font-size: 22px;">{String(links.length).padStart(2, "0")}</span></div>
          <ul class="list">
            {links.map(([l, href]) => <li><a href={href}><span>{l}</span><span class={dark ? "lime" : ""} aria-hidden="true">→</span></a></li>)}
          </ul>
        </nav>
      );
    })}
  </div>
</SiteLayout>
