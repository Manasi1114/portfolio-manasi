---
// About (Figma: Page · About).
import SiteLayout from "../layouts/SiteLayout.astro";
import Title from "../components/Title.astro";
import { CV_URL, EMAIL } from "../data/site.js";
---

<SiteLayout title="About" section="about">
  <div class="row row-2-1">
    <section class="tile t-navy pad-lg" style="gap: 18px;">
      <p class="label">About</p>
      <Title text="About me." />
      <p class="lede">
        I design websites, digital products and books, starting from field research. Freelancing now · M.Des.
        Communication Design, Dhirubhai Ambani University, 2026.
      </p>
      <div class="btns">
        <a class="btn btn-lime" href={CV_URL}>Download CV</a>
        <a class="btn" href={`mailto:${EMAIL}`}>Say hello →</a>
      </div>
    </section>
    <figure class="media" style="background: var(--paper); min-height: 300px;">
      <img src="/web/flower1.png" alt="Botanical illustration of a flowering branch with a butterfly" style="object-fit: cover;" />
    </figure>
  </div>

  <div class="row row-2-1">
    <blockquote class="tile t-white pad-lg" style="gap: 16px;">
      <p class="hand" style="font-size: clamp(22px, 2.2vw, 30px); line-height: 1.3;">
        “I think the story is more strange than it is true. I don’t believe any of these ancient stories or fairy
        tales. Lovers and madmen have so much going on in their heads, such active imaginations, that they see and hear
        things that cool, calm, rational people can’t understand.”
      </p>
      <p class="label muted">— William Shakespeare, A Midsummer Night’s Dream</p>
    </blockquote>
    <section class="tile t-steel">
      <p class="label">Why this quote</p>
      <p style="font-size: 17px;">
        I think these words were written for me. Shakespeare likely had a vision that a girl in the far corners of the
        world six hundred years in the future would hold them to her heart and try to live her life that way. I am
        always on the lookout of documenting everything that I relate; this website is a time capsule for my diaries.
      </p>
    </section>
  </div>

  <div class="row row-4">
    {[
      ["Based in", "Ahmedabad", "Relocating to Bangalore", "t-white"],
      ["Status", "Freelancing", "Available for work", "t-white"],
      ["Studied", "M.Des", "Communication Design, DAU · 2026", "t-white"],
      ["Approach", "Research led", "Value-based, clean design", "t-ice"],
    ].map(([k, v, s, c]) => (
      <div class={`tile ${c}`}>
        <p class="label muted">{k}</p>
        <p class="display d-md" style="font-size: clamp(24px, 2.2vw, 32px);">{v}</p>
        <p class="muted small">{s}</p>
      </div>
    ))}
  </div>

  <div class="row row-2-1">
    <div class="tile t-white">
      <p class="label muted">Skills</p>
      <p class="display d-xs">Field research &amp; ethnography · Digital experience design · Communication design</p>
    </div>
    <div class="tile t-white">
      <p class="label muted">Tools</p>
      <p class="display d-xs">Figma · Astro</p>
    </div>
  </div>

  <section class="tile t-navy pad-lg">
    <p class="label">Come, say hello to me!</p>
    <a class="email" href={`mailto:${EMAIL}`}>{EMAIL} →</a>
  </section>
</SiteLayout>
