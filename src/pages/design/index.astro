---
// Design Notes (Figma: Page · Design Notes). Links to Design Styles and the Source Catalogue,
// which keep their own designs.
import SiteLayout from "../../layouts/SiteLayout.astro";
import Title from "../../components/Title.astro";
---

<SiteLayout title="Design Notes" section="notes" description="Manasi's design notes: a field guide to design styles and a catalogue of design sources.">
  <section class="tile t-navy pad-lg">
    <p class="label">Collections · Design Notes</p>
    <Title text="Design notes." />
    <p class="lede">Things I keep while learning to look more closely.</p>
  </section>

  <div class="row row-1-1">
    <section class="tile t-steel pad-lg">
      <div class="top"><p class="label">My collection · 01</p><span class="tag">01</span></div>
      <h2 class="display d-md">Design Styles</h2>
      <p style="font-size: 18px;">Fifty design styles with specimens, real references and prompts I can reuse.</p>
      <p class="num lime" style="font-size: 64px;">50</p>
      <a class="btn push" href="/design/styles">Explore →</a>
    </section>
    <section class="tile t-white pad-lg">
      <div class="top"><p class="label muted">My collection · 02</p><span class="tag tag-lime">02</span></div>
      <h2 class="display d-md">Source Catalogue</h2>
      <p style="font-size: 18px;">Where I look for references and usable images, filterable by project, need and rights.</p>
      <p class="num" style="font-size: 64px;">27</p>
      <a class="btn btn-red push" href="/design-source-catalogue">Explore →</a>
    </section>
  </div>

  <div class="row row-4">
    {[["50", "Design styles", "t-white"], ["05", "Style families", "t-white"], ["27", "Sources", "t-white"], ["06", "Source groups", "t-ice"]].map(([v, k, c]) => (
      <div class={`tile ${c}`}><p class="num">{v}</p><p class="muted">{k}</p></div>
    ))}
  </div>
</SiteLayout>
