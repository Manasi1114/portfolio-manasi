---
// Quotes (Figma: Page · Quotes).
import SiteLayout from "../layouts/SiteLayout.astro";
import Title from "../components/Title.astro";

const quotes = Object.values(import.meta.glob("./quotes/*.md", { eager: true }))
  .sort((a, b) => (a.frontmatter.order ?? 9) - (b.frontmatter.order ?? 9));
---

<SiteLayout title="Quotes" section="writing" description="Lines worth keeping, and why they stay with me.">
  <section class="tile t-navy pad-lg">
    <p class="label">Off the clock · Quotes</p>
    <Title text="Lines worth keeping." />
    <p class="hand" style="font-size: 22px; line-height: 1.45; max-width: 60ch;">
      “I have the world’s largest collection of seashells. I keep it on all the beaches of the world… perhaps you’ve seen it.” — Steven Wright
    </p>
  </section>

  {quotes.map((q, i) => {
    const f = q.frontmatter;
    return (
      <div class="row row-2-1">
        <blockquote class={`tile pad-lg ${i % 2 ? "t-ice" : "t-white"}`} style="gap: 16px;">
          <div class="top">
            <a class="label muted" href={q.url} style="text-decoration: none;">{String(i + 1).padStart(2, "0")} · {f.title}</a>
            <span class={i === 0 ? "tag tag-lime" : "tag"}>{f.author.split(" ").pop()}</span>
          </div>
          <p class="hand" style="font-size: clamp(22px, 2.2vw, 30px); line-height: 1.3;">“{f.quote}”</p>
          <p class="label muted">— {f.author}{f.bibliography ? `, ${f.bibliography}` : ""}</p>
        </blockquote>
        <section class={`tile ${i === 0 ? "t-navy" : "t-steel"}`}>
          <p class="label">Why it stays with me</p>
          <p style="font-size: 18px;">{f.thoughts}</p>
        </section>
      </div>
    );
  })}
</SiteLayout>
