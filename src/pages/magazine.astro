---
// Magazine (Figma: Page · Magazine).
import SiteLayout from "../layouts/SiteLayout.astro";
import Title from "../components/Title.astro";
import { PHOTOS } from "../data/site.js";
const heights = [500, 360, 440, 560, 600, 440];
---

<SiteLayout title="Magazine" description="Photographs from campus, cities and the light in between.">
  <section class="tile t-navy pad-lg">
    <p class="label">Off the clock · Magazine</p>
    <Title text="I see." />
    <p class="lede">Photographs from campus, cities and the light in between.</p>
  </section>

  {PHOTOS.map((row, r) => (
    <div class={`row ${row.length === 3 ? "row-3" : row.length === 2 ? (r === 0 ? "row-2-1" : "row-1-1") : ""} mag-row`} style={`--h: ${heights[r]}px;`}>
      {row.map((p) => (
        <figure>
          <div class="media mag"><img src={p.src} alt={p.caption} loading="lazy" /></div>
          <figcaption class="figcap">{p.caption}</figcaption>
        </figure>
      ))}
    </div>
  ))}
</SiteLayout>

<style>
  .mag { height: var(--h); }
  @media (max-width: 860px) {
    .mag-row { grid-template-columns: 1fr !important; }
    .mag { height: auto; aspect-ratio: 4 / 3; }
  }
</style>
