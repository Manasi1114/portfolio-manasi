---
// Socials (Figma: Page · Socials). Only accounts with a real address are listed.
import SiteLayout from "../layouts/SiteLayout.astro";
import Title from "../components/Title.astro";
import { CV_URL, EMAIL, INSTAGRAM } from "../data/site.js";
---

<SiteLayout title="Socials" section="about" description="Find Manasi Shrivastava online, or write to her directly.">
  <section class="tile t-navy pad-lg">
    <p class="label">Connect</p>
    <Title text="Say hello." />
    <p class="lede">Find me in these places, or write to me directly.</p>
  </section>

  <div class="row row-1-1">
    <section class="tile t-navy">
      <p class="label">Most active</p>
      <h2 class="display d-md">Instagram</h2>
      <p class="muted">{INSTAGRAM.handle}</p>
      <a class="btn btn-lime push" href={INSTAGRAM.url}>Open Instagram →</a>
    </section>
    <section class="tile t-white">
      <p class="label muted">Email</p>
      <h2 class="display d-md">Write to me</h2>
      <p class="muted">{EMAIL}</p>
      <a class="btn push" href={`mailto:${EMAIL}`}>Send an email →</a>
    </section>
  </div>

  <section class="tile t-navy pad-lg">
    <p class="label">Come, say hello to me!</p>
    <a class="email" href={`mailto:${EMAIL}`}>{EMAIL} →</a>
    <a class="btn btn-lime" href={CV_URL}>Download CV</a>
  </section>
</SiteLayout>
