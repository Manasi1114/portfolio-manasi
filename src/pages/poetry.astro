---
// Poetry (Figma: Page · Poetry).
import SiteLayout from "../layouts/SiteLayout.astro";
import Title from "../components/Title.astro";

const poems = Object.values(import.meta.glob("./poetry/*.md", { eager: true }))
  .sort((a, b) => (a.frontmatter.order ?? 9) - (b.frontmatter.order ?? 9));
const firstLines = (p) =>
  p.rawContent().split("\n").map((l) => l.trim()).filter((l) => l && !/^part\s/i.test(l) && !l.startsWith("<")).slice(0, 3).join("\n");
---

<SiteLayout title="Poetry" section="writing" description="Poems I wrote and poems I keep coming back to.">
  <div class="row row-2-1">
    <section class="tile t-navy pad-lg">
      <p class="label">Off the clock · Poetry</p>
      <Title text="Poetry." />
      <p class="hand" style="font-size: 22px; line-height: 1.45;">
        “A poem begins as a lump in the throat, a sense of wrong, a homesickness, a lovesickness.” — Robert Frost
      </p>
    </section>
    <figure class="media" style="background: var(--paper); min-height: 260px;">
      <img src="/web/flower2.png" alt="Botanical illustration of a white flower with butterflies" />
    </figure>
  </div>

  <div class="row row-1-1">
    {poems.map((p, i) => (
      <article class="tile t-white pad-lg">
        <div class="top">
          <p class="label muted">Poem · {String(i + 1).padStart(2, "0")}</p>
          {p.frontmatter.mine && <span class="tag tag-lime">Mine</span>}
        </div>
        <h2 class="display d-sm">{p.frontmatter.title}</h2>
        <p class="muted" style="font-size: 16px;">by {p.frontmatter.poet}</p>
        <p class="hand" style="font-size: 20px; line-height: 1.5; white-space: pre-line;">{firstLines(p)}</p>
        <a class="link push" href={p.url}>Read the poem →</a>
      </article>
    ))}
  </div>
</SiteLayout>
