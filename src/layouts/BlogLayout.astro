---
// Blog post (Figma: Page · Blog post — Girls’ trip to Udaipur).
import SiteLayout from "./SiteLayout.astro";
import Title from "../components/Title.astro";

const { frontmatter, url } = Astro.props;
const posts = Object.values({
  ...import.meta.glob("../pages/posts/*.md", { eager: true }),
  ...import.meta.glob("../pages/blog/*.md", { eager: true }),
}).sort((a, b) => (a.frontmatter.order ?? 9) - (b.frontmatter.order ?? 9));
const others = posts.filter((p) => p.frontmatter.title !== frontmatter.title);
const t = frontmatter.title;
---

<SiteLayout title={t} description={frontmatter.description} section="writing">
  <section class="tile t-navy pad-lg">
    <p class="label">Blog · {frontmatter.category}</p>
    <Title text={/[.!?]$/.test(t) ? t : t + "."} />
  </section>

  <div class="row row-2-1" style="align-items: start;">
    <div class="col">
      {frontmatter.image?.url && (
        <figure class="media" style="aspect-ratio: 904 / 460;">
          <img src={frontmatter.image.url} alt="" style={`object-position: ${frontmatter.focus ?? "center"}`} />
          {frontmatter.caption && <figcaption class="caption-strip">{frontmatter.caption}</figcaption>}
        </figure>
      )}
      <article class="tile t-white pad-lg prose">
        <slot />
      </article>
    </div>
    <aside class="col">
      <div class="tile t-steel">
        <p class="label">About this post</p>
        <ul class="kv">
          <li><span>Filed under</span><span>{frontmatter.category}</span></li>
          {frontmatter.date && <li><span>Written</span><span>{frontmatter.date}</span></li>}
        </ul>
      </div>
      <nav class="tile t-white" aria-label="More posts">
        <p class="label muted">More posts</p>
        <ul class="list">
          {others.map((p) => <li><a href={p.url}><span>{p.frontmatter.title}</span><span aria-hidden="true">→</span></a></li>)}
        </ul>
      </nav>
    </aside>
  </div>
</SiteLayout>
