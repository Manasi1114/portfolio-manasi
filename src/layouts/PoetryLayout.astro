---
// Poem page (Figma: Page · Poem — Study of People).
import SiteLayout from "./SiteLayout.astro";
import Title from "../components/Title.astro";

const { frontmatter } = Astro.props;
const poems = Object.values(import.meta.glob("../pages/poetry/*.md", { eager: true }))
  .sort((a, b) => (a.frontmatter.order ?? 9) - (b.frontmatter.order ?? 9));
const others = poems.filter((p) => p.frontmatter.title !== frontmatter.title);
---

<SiteLayout title={frontmatter.title} description={`${frontmatter.title}, by ${frontmatter.poet}.`} section="writing">
  <div class="row row-2-1" style="align-items: start;">
    <article class="tile t-white pad-lg" style="gap: 22px;">
      <p class="label muted">Poetry{frontmatter.mine ? " · mine" : ""}</p>
      <Title text={frontmatter.title + "."} dark={false} size="d-lg" />
      <p class="muted">by {frontmatter.poet}</p>
      <div class="hand poem" style="font-size: clamp(19px, 1.8vw, 24px); line-height: 1.6; white-space: pre-line;">
        <slot />
      </div>
      <p class="link muted">— {frontmatter.poet}</p>
    </article>
    <aside class="col">
      <figure class="media" style="background: var(--paper); aspect-ratio: 456 / 560;">
        <img src="/web/flower1.png" alt="" />
      </figure>
      <nav class="tile t-navy" aria-label="More poems">
        <p class="label">More poems</p>
        <ul class="list">
          {others.map((p) => <li><a href={p.url}><span>{p.frontmatter.title} — {p.frontmatter.poet}</span><span class="lime" aria-hidden="true">→</span></a></li>)}
        </ul>
      </nav>
      <a class="btn" href="/poetry">← All poems</a>
    </aside>
  </div>
</SiteLayout>

<style>
  .poem :global(p) { margin: 0 0 1.2em; }
</style>
