---
// Single quote page, in the Quotes page style.
import SiteLayout from "./SiteLayout.astro";

const { frontmatter: f } = Astro.props;
---

<SiteLayout title={`${f.title} — ${f.author}`} description={f.quote} section="writing">
  <div class="row row-2-1">
    <blockquote class="tile t-white pad-lg" style="gap: 18px;">
      <p class="label muted">Quotes · {f.title}</p>
      <p class="hand" style="font-size: clamp(24px, 2.6vw, 36px); line-height: 1.3;">“{f.quote}”</p>
      <p class="label muted">— {f.author}{f.bibliography ? `, ${f.bibliography}` : ""}</p>
    </blockquote>
    <section class="tile t-navy">
      <p class="label">Why it stays with me</p>
      <p style="font-size: 18px;">{f.thoughts}</p>
      <a class="btn btn-lime push" href="/quotes">← All quotes</a>
    </section>
  </div>
</SiteLayout>
