---
// Field report page (Figma: Page · Field report — Ponk Nagari of Surat).
import SiteLayout from "./SiteLayout.astro";
import Title from "../components/Title.astro";

const { frontmatter, url } = Astro.props;
const reports = Object.values(import.meta.glob("../pages/projects/*.md", { eager: true }))
  .sort((a, b) => (a.frontmatter.order ?? 9) - (b.frontmatter.order ?? 9));
const i = reports.findIndex((r) => r.frontmatter.title === frontmatter.title);
const next = reports[(i + 1) % reports.length];
---

<SiteLayout title={frontmatter.title} description={frontmatter.description} section="work">
  <section class="tile t-navy pad-lg">
    <p class="label">Field report · {frontmatter.dateLabel}</p>
    <Title text={frontmatter.title + "."} />
    {frontmatter.description && <p class="lede">{frontmatter.description}</p>}
  </section>

  {frontmatter.image?.url && (
    <figure class="media" style="aspect-ratio: 1376 / 520;">
      <img src={frontmatter.image.url} alt={`${frontmatter.title}: cover photo`} />
    </figure>
  )}

  <div class="row row-2-1" style="align-items: start;">
    <article class="tile t-white pad-lg prose">
      <slot />
    </article>
    <aside class="col">
      {frontmatter.glance && (
        <div class="tile t-steel">
          <p class="label">At a glance</p>
          <ul class="kv">
            {frontmatter.glance.map(([k, v]) => <li><span>{k}</span><span>{v}</span></li>)}
          </ul>
        </div>
      )}
      <a class="btn" href="/work">← All work</a>
    </aside>
  </div>

  {next && next.url !== url && (
    <section class="tile t-navy pad-lg">
      <p class="label">Next field report</p>
      <h2 class="display d-sm">{next.frontmatter.title}</h2>
      <a class="btn btn-lime" href={next.url}>Read the next report →</a>
    </section>
  )}
</SiteLayout>
